<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Calculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorButtonOperator</item>
        <item name="colorPrimaryVariant">@color/colorButtonOperator</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
    </style>

    <style name="CalcButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">center</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator" tools:targetApi="21">@null</item>
    </style>

    <style name="CalcButton.Number">
        <item name="android:background">@drawable/btn_number</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="android:background">@drawable/btn_operator</item>
        <item name="android:textColor">@color/colorTextOperator</item>
    </style>

    <style name="CalcButton.Special">
        <item name="android:background">@drawable/btn_special</item>
        <item name="android:textColor">@color/colorTextSpecial</item>
    </style>

    <style name="CalcButton.Function">
        <item name="android:background">@drawable/btn_function</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="CalcButton.Memory">
        <item name="android:background">@drawable/btn_function</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_margin">3dp</item>
    </style>

</resources>
